# =============================================================================
# CINEMA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

APP_NAME="3D Cinema Platform API"
APP_VERSION="1.0.0"
APP_ENV="production"
DEBUG="false"
LOG_LEVEL="INFO"

# Security (Change to a strong random key in production)
SECRET_KEY="replace_with_a_secure_random_key_in_production"

# Network & CORS
PORT=8000
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://*.vercel.app"]

# Database (Optional - falls back gracefully or connects to PostgreSQL)
DATABASE_URL="postgresql+asyncpg://cinema_user:cinema_password@localhost:5432/cinema_platform"
DATABASE_SYNC_URL="postgresql://cinema_user:cinema_password@localhost:5432/cinema_platform"

# Redis (Optional)
REDIS_URL="redis://localhost:6379/0"

# Business Invariants
SEAT_LOCK_EXPIRATION_SECONDS=600
