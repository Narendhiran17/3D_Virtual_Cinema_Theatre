{
  "name": "3d-virtual-cinema-theatre",
  "version": "1.0.0",
  "description": "3D Virtual Cinema Theatre with YouTube CinemaScope Player and 2D Interactive Seating Matrix",
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "preview": "npm --prefix app run preview",
    "backend:dev": "cd backend && uvicorn app.main:app --reload --port 8000",
    "backend:start": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000"
  },
  "keywords": [
    "threejs",
    "blender",
    "virtual-cinema",
    "css3d",
    "cinemascope",
    "youtube-player",
    "fastapi",
    "render",
    "vercel"
  ],
  "author": "Antigravity",
  "license": "MIT"
}
